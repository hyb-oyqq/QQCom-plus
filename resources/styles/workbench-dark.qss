/* QQCom 暗色主题样式表 */
/* 与浅色版本保持相同的结构，只调整颜色值以适配暗色环境 */

QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    /* 与浅色表同一套字号：控件 12px，数据面 13px，状态栏 11px。 */
    font-size: 12px;
    color: #e8ecf1;
}
QPlainTextEdit#trafficText,
QPlainTextEdit#sendEditor,
QLabel#payloadPreview {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    color: #8b95a8;
    background: #1e2433;
    border-radius: 4px;
    padding: 0 6px;
}
QLabel#payloadPreview[invalid="true"] { color: #f0a8a8; background: #3a2428; }
QMainWindow, QWidget#centralwidget { background: #1a1f2e; }
QLabel#Muted, QLabel#udpPeerHint, QLabel#StatusNote { color: #8b95a8; font-size: 11px; }
QLabel#StatusNote[tone="error"] { color: #f0a8a8; font-size: 11px; font-weight: 600; }
QLabel#openFailure {
    color: #f0a8a8;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    padding-left: 25px;
}
QLabel#enterToSendHint {
    color: #f6d7a8;
    font-size: 11px;
    background: #3a2e1c;
    border: 1px solid #6b5230;
    border-radius: 4px;
    padding: 0 6px;
}
QLabel#framingHint { font-size: 12px; color: #8b95a8; }
/* 字节数的颜色**不在这里**：它与预览文本合并在同一个 QLabel 里、用富文本 span 着色
   （见 sendpanel.cpp 的 ByteCountColor）。QSS 不作用于 span，所以那个值必须写在代码里。 */
QLabel#EmptyState { background: #1e2433; color: #7a8599; border: 1px dashed #3d4758; border-radius: 5px; }
QWidget#Surface { background: #242936; border: 1px solid #2f3749; border-radius: 8px; }
/* 与浅色表同款：端口条 = 卡片外观（见 workbench.qss 的说明）。 */
QFrame#EndpointBar { background: #242936; border: 1px solid #2f3749; border-radius: 8px; }
QFrame#EndpointDivider { color: #2d3649; max-height: 1px; }
QFrame#BridgeDivider { color: #2f3749; max-width: 1px; }
/* 与浅色表同一套端口身份色，不随主题变：数据区的琥珀和青也是固定色。 */
QLabel#EndpointBadge { background: #1d4ed8; color: #ffffff; border: 1px solid #1a45c0; border-radius: 10px; font-size: 12px; font-weight: 700; }
QLabel#EndpointBadge[port="A"] { background: #B45309; border: 1px solid #92400e; }
QLabel#EndpointBadge[port="B"] { background: #0E7490; border: 1px solid #155e75; }
/* 端点行不再铺底：自绘背景会盖掉端口条的圆角（见浅色表的说明）。 */
PortSelectorWidget { background: transparent; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: #242936; }
QPushButton, QToolButton { background: #2d3548; border: 1px solid #434d64; border-radius: 4px; padding: 2px 8px; min-height: 16px; color: #d4dae5; }
QPushButton:hover, QToolButton:hover { color: #e8eefb; border-color: #5a6885; background: #353e56; }
QPushButton:pressed, QToolButton:pressed { background: #3d4861; border-color: #6b7a9a; }
/* 勾选态的黄与「扩展」收起态同一套，不要再另用一档暗金。 */
QPushButton:checked { background: #d97706; border-color: #92400e; color: #fef3c7; }
QPushButton:checked:hover { background: #f59e0b; border-color: #b45309; color: #fffbeb; }
QPushButton:checked:pressed { background: #b45309; border-color: #92400e; }
QPushButton:disabled { background: #252b3d; border-color: #3d4758; color: #5a6377; }
/* A/B 端点开关：单字母。宽度钉死，左右内边距不再把字母裁掉或撑成方块。使能走上面那套黄。 */
QPushButton#showPortA, QPushButton#showPortB { font-size: 12px; font-weight: 700; padding: 2px 0; min-width: 16px; max-width: 16px; }
QPushButton#showPortA:!checked, QPushButton#showPortB:!checked { background: #2d3548; border-color: #434d64; color: #7a8599; }
QPushButton#showPortA:!checked:hover, QPushButton#showPortB:!checked:hover { border-color: #5a6885; color: #9aa7bd; }
QPushButton#commandPanelToggle:checked { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-size: 12px; font-weight: 600; }
QPushButton#commandPanelToggle:checked:hover { background: #2860e8; border-color: #2860e8; }
QPushButton#commandPanelToggle:checked:pressed { background: #1a45c0; }
QPushButton#commandPanelToggle:!checked { background: #d97706; border-color: #92400e; color: #fef3c7; font-size: 12px; font-weight: 600; }
QPushButton#commandPanelToggle:!checked:hover { background: #f59e0b; border-color: #b45309; color: #fffbeb; }
QPushButton#commandPanelToggle:!checked:pressed { background: #b45309; border-color: #92400e; }
QPushButton#commandPanelToggle[collapsed="true"] { background: #d97706; border-color: #92400e; color: #fef3c7; font-size: 12px; font-weight: 600; }
QPushButton#commandPanelToggle[collapsed="false"] { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-size: 12px; font-weight: 600; }
QPushButton#clearTraffic { background: #3a2424; border-color: #8a4038; color: #f0b4ac; font-size: 12px; font-weight: 600; }
QPushButton#clearTraffic:hover { background: #4a2c2c; border-color: #c0392b; color: #f8d6d1; }
QPushButton#clearTraffic:pressed { background: #5a3330; border-color: #a7301f; color: #f8d6d1; }
QPushButton#clearTraffic:disabled { background: #2d3548; border-color: #434d64; color: #7a8599; }
/* 与浅色表一致：发送按钮和同排控件同高，只靠颜色和字重区分。
   按下比常态更深，并且写在悬停后面（两者特异性相同，写反了按住时仍是悬停色）。 */
QPushButton#PrimaryButton { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-size: 12px; font-weight: 600; min-height: 16px; padding: 2px 14px; }
QPushButton#PrimaryButton:hover { background: #2860e8; border-color: #2860e8; }
QPushButton#PrimaryButton:pressed,
QPushButton#PrimaryButton:hover:pressed { background: #102a6b; border-color: #0b1d4d; }
QPushButton#PrimaryButton:disabled { background: #3d4a6b; border-color: #2d3952; color: #5a6885; }
QPushButton#fileTransferStart, QPushButton#fileReceiveStart { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-size: 12px; font-weight: 600; }
QPushButton#fileTransferStart:hover, QPushButton#fileReceiveStart:hover { background: #2860e8; border-color: #2860e8; }
QPushButton#fileTransferStart:disabled, QPushButton#fileReceiveStart:disabled { background: #3d4a6b; border-color: #2d3952; color: #5a6885; }
QPushButton#fileTransferStart[busy="true"], QPushButton#fileReceiveStart[busy="true"] { background: #c0392b; border-color: #a7301f; color: #ffffff; }
QPushButton#fileTransferStart[busy="true"]:hover, QPushButton#fileReceiveStart[busy="true"]:hover { background: #d44332; border-color: #d44332; }
QProgressBar#fileTransferProgress, QProgressBar#fileReceiveProgress { border: 1px solid #434d64; border-radius: 5px; background: #1e2433; text-align: center; color: #e8ecf1; }
QProgressBar#fileTransferProgress::chunk, QProgressBar#fileReceiveProgress::chunk { background: #1d4ed8; border-radius: 4px; margin: 1px; }
QPushButton#bridgeButton { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-size: 12px; font-weight: 600; }
QPushButton#bridgeButton:hover { background: #2860e8; border-color: #2860e8; }
QPushButton#bridgeButton[open="true"] { background: #c0392b; border-color: #a7301f; }
QPushButton#bridgeButton[open="true"]:hover { background: #d44332; border-color: #d44332; }
QPushButton#endpointAction { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-size: 12px; font-weight: 600; }
QPushButton#endpointAction:hover { background: #2860e8; border-color: #2860e8; }
QPushButton#endpointAction:disabled { background: #3d4a6b; border-color: #2d3952; color: #5a6885; }
QPushButton#endpointAction[open="true"] { background: #c0392b; border-color: #a7301f; }
QPushButton#endpointAction[open="true"]:hover { background: #d44332; border-color: #d44332; }
QPushButton#endpointAction[recovering="true"] { background: #facc15; border-color: #a16207; color: #713f12; }
QPushButton#endpointAction[recovering="true"]:hover { background: #fde047; border-color: #854d0e; color: #713f12; }
QPushButton#bridgeButton:disabled { background: #3d4a6b; border-color: #2d3952; color: #5a6885; }
QToolButton::menu-indicator { width: 0px; }
QMenu { background: #242936; border: 1px solid #434d64; padding: 4px; color: #e8ecf1; }
QMenu::item { padding: 4px 14px; }
QMenu::item:selected { background: #1d4ed8; color: #ffffff; }
QMenu::item:disabled { color: #5a6377; }
QMenu::separator { height: 1px; background: #434d64; margin: 4px 8px; }
QToolButton#advancedToggle { border: none; background: transparent; color: #8b95a8; padding: 1px 2px; }
QToolButton#advancedToggle:hover { color: #5b9eff; background: transparent; }
QToolButton#advancedToggle:checked { color: #5b9eff; background: transparent; }
QWidget#advancedPanel { background: #1e2433; border-top: 1px solid #2f3749; }
QLineEdit, QComboBox, QSpinBox { background: #1e2433; border: 1px solid #434d64; border-radius: 4px; padding: 2px 6px; min-height: 16px; selection-background-color: #1d4ed8; selection-color: #ffffff; color: #e8ecf1; }
/* 内嵌编辑框使用外层编辑区。再叠加通用输入框的边框和内边距，数字框会比下拉框更高。 */
QComboBox QLineEdit, QSpinBox QLineEdit { background: transparent; border: none; border-radius: 0; padding: 0; min-height: 0; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #5a6885; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus { border-color: #5b9eff; }
QLineEdit[invalid="true"], QComboBox[invalid="true"], QSpinBox[invalid="true"] { border-color: #c0392b; background: #2d1e1e; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { background: #1e2433; color: #5a6377; border-color: #3d4758; }
QComboBox { padding-right: 20px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border: none; }
QComboBox::down-arrow { image: url(:/icons/chevron-down.xpm); width: 10px; height: 6px; }
QComboBox QAbstractItemView { background: #242936; selection-background-color: #1d4ed8; selection-color: #ffffff; border: 1px solid #434d64; outline: none; color: #e8ecf1; }
QPlainTextEdit { background: #1e2433; border: 1px solid #434d64; border-radius: 5px; padding: 9px; selection-background-color: #1d4ed8; selection-color: #ffffff; color: #e8ecf1; }
QCheckBox { spacing: 4px; color: #d4dae5; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #5a6885; border-radius: 3px; background: #1e2433; }
QCheckBox::indicator:hover { border-color: #5b9eff; }
QCheckBox::indicator:checked {
    background: #1d4ed8;
    border-color: #1a45c0;
    image: url(:/icons/check-white.svg);
}
QCheckBox::indicator:checked:hover { background: #2860e8; }
QCheckBox::indicator:disabled { background: #1e2433; border-color: #3d4758; }
/* 批量发送进度：与浅色表同一套语义（琥珀=正在发，绿=已发），只按深色调色板调亮度。 */
QCheckBox[sendState="sending"]::indicator:checked { background: #d97706; border-color: #92400e; }
QCheckBox[sendState="sent"]::indicator:checked { background: #047857; border-color: #03674a; }
QPushButton[sending="true"] { background: #d97706; border-color: #92400e; color: #fef3c7; font-size: 12px; font-weight: 600; }
QPushButton[sending="true"]:hover { background: #f59e0b; border-color: #b45309; color: #fffbeb; }
QWidget#BridgeRow { background: #1e2433; }
QSplitter::handle { background: transparent; }
QSplitter::handle:vertical { height: 6px; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:hover { background: #2f3749; }
/* 与浅色表同款：状态栏所有标签统一字号，写了 font-weight 的规则必须带上 font-size。 */
QStatusBar QLabel { font-size: 11px; }
QStatusBar { background: #242936; border-top: 1px solid #343d52; min-height: 26px; }
QStatusBar::item { border: none; }
QFrame#StatusSep { background: #3d4758; border: none; }
QWidget#EndpointChip { background: #1e2433; border: 1px solid #343d52; border-radius: 4px; }
QFrame#StatusDot { background: #6b7690; border: none; border-radius: 3px; }
QFrame#StatusDot[state="open"] { background: #10b981; }
QFrame#StatusDot[state="opening"] { background: #f59e0b; }
QFrame#StatusDot[state="closed"] { background: #6b7690; }
QFrame#StatusDot[state="error"] { background: #f87171; }
QFrame#StatusDot[state="warning"] { background: #fbbf24; }
QWidget[statusActionContainer="true"] { background: #1e2433; border: 1px solid #343d52; border-radius: 4px; }
QStatusBar QToolButton[statusAction="true"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 0 2px;
    margin: 0;
    min-height: 0;
    min-width: 0;
    font-size: 11px;
    color: #c5d0e0;
}
QStatusBar QToolButton#stayOnTop, QStatusBar QToolButton#colorScheme { padding: 0; }
QStatusBar QToolButton[statusAction="true"]:hover {
    background: #2c3548;
    border-color: transparent;
    color: #e8eefb;
}
QStatusBar QToolButton[statusAction="true"]:pressed,
QStatusBar QToolButton[statusAction="true"]:checked {
    background: #3d4861;
    border-color: transparent;
    color: #e8eefb;
}
QLabel#StatusKey, QLabel#StatusKeyRx, QLabel#StatusKeyTx, QLabel#StatusKeyDrop, QLabel#EndpointName {
    font-size: 11px;
    font-weight: 600;
}
QLabel#StatusKey { color: #8b95a8; }
QLabel#StatusKeyRx { color: #10b981; }
QLabel#StatusKeyTx { color: #5b9eff; }
QLabel#StatusKeyDrop, QLabel#DropStatus { color: #f0a8a8; }
QLabel#EndpointName { color: #e8ecf1; }
QLabel#RxStatus, QLabel#TxStatus { color: #e8ecf1; font-size: 11px; font-weight: 600; }
QLabel#DropStatus { font-size: 11px; font-weight: 600; }
QLabel#StatusRate, QLabel#TrafficStatus, QLabel#RouteStatus, QLabel#EndpointState { color: #8b95a8; }
QLabel#RouteStatus[active="true"] { color: #8eb6ff; font-size: 11px; font-weight: 600; }
QTableView {
    background: #242936;
    alternate-background-color: #1e2433;
    gridline-color: #2f3749;
    border: 1px solid #2f3749;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
    color: #e8ecf1;
}
QHeaderView::section {
    background: #1e2433;
    color: #a5b1c7;
    border: none;
    border-right: 1px solid #2f3749;
    border-bottom: 1px solid #2f3749;
    padding: 4px;
    font-size: 12px;
    font-weight: 600;
}
QHeaderView::section:hover { background: #252b3d; }
QTableView::item { padding: 2px; }
QTableView::item:selected { background: #1d4ed8; color: #ffffff; }
QTableView QLineEdit { background: #1e2433; border: 1px solid #5b9eff; }
SendPanel QTabWidget::pane {
    border: none;
    background: transparent;
    top: 0px;
}
/* 基线已在代码里关掉（QTabBar::setDrawBase）。这里再铺卡片色，避免页签之间的空隙
   透出浅色调色板。 */
SendPanel QTabBar {
    background: #242936;
    border: none;
}
SendPanel QTabBar::tab {
    background: #2d3548;
    border: 1px solid #434d64;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 2px 10px;
    margin-right: 2px;
    font-size: 12px;
    color: #8b95a8;
}
SendPanel QTabBar::tab:selected {
    background: #242936;
    color: #8eb6ff;
    font-size: 12px;
    font-weight: 600;
    border-bottom: 2px solid #5b9eff;
}
SendPanel QTabBar::tab:hover:!selected {
    background: #353e56;
    color: #d4dae5;
}
QToolTip { color: #f4f6fa; background: #26324a; border: 1px solid #26324a; padding: 5px; }
QScrollBar:vertical { background: #1a1f2e; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #434d64; min-height: 30px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #5a6885; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #1a1f2e; height: 9px; margin: 0; }
QScrollBar::handle:horizontal { background: #434d64; min-width: 30px; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QFrame#FilterDivider { color: #2d3649; max-width: 1px; }
QPushButton#filterRx, QPushButton#filterTx,
QPushButton#viewPureData, QPushButton#viewHexEcho, QPushButton#viewLineWrap,
QPushButton#filterCaseSensitive, QPushButton#filterRegex,
QPushButton#filterRebuild { padding: 2px 6px; }

/* 与浅色表同一套结构。底和字按深色表面取，选中行用主蓝加白字。 */
CommandPanel { background: #242936; border-left: 1px solid #2f3749; }
CommandPanel QTableWidget {
    background: #242936;
    border: 1px solid #2f3749;
    border-radius: 5px;
    gridline-color: #2f3749;
    color: #e8ecf1;
}
CommandPanel QTableWidget::item { padding: 0px; color: #e8ecf1; }
CommandPanel QTableWidget::item:selected { background: #1d4ed8; color: #ffffff; }
CommandPanel QHeaderView::section {
    background: #1e2433;
    border: none;
    border-right: 1px solid #2f3749;
    border-bottom: 1px solid #2f3749;
    padding: 4px 4px;
    font-size: 12px;
    font-weight: 600;
    color: #8b95a8;
}
CommandPanel QPushButton#primaryButton {
    background: #1d4ed8;
    border-color: #1a45c0;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
}
CommandPanel QPushButton#primaryButton:hover { background: #2860e8; border-color: #2860e8; }
CommandPanel QTabWidget::pane {
    background: #242936;
    border: 1px solid #2f3749;
    border-radius: 5px;
    top: -1px;
}
CommandPanel QTabBar::tab {
    background: #2d3548;
    border: 1px solid #434d64;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 3px 10px;
    margin-right: 2px;
    font-size: 12px;
    color: #8b95a8;
}
CommandPanel QTabBar::tab:selected {
    background: #242936;
    color: #8eb6ff;
    font-size: 12px;
    font-weight: 600;
    border-bottom: 2px solid #5b9eff;
}
CommandPanel QTabBar::tab:hover:!selected { background: #353e56; color: #d4dae5; }
QLabel#commandDragHandle { color: #8b95a8; background: #2d3548; }

/* 弹窗文字跟这份表走。不要在对话框上再写浅色字，否则深色底上仍是深字。 */
QMessageBox, QInputDialog, QDialog {
    background: #242936;
    color: #e8ecf1;
}
QMessageBox QLabel, QInputDialog QLabel {
    color: #e8ecf1;
    background: transparent;
}
QDialog QPushButton { min-width: 70px; padding: 2px 12px; }
QDialog QPushButton:default {
    background: #1d4ed8;
    border-color: #1a45c0;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
}
QDialog QPushButton:default:hover { background: #2860e8; border-color: #2860e8; }
QListWidget {
    background: #1e2433;
    color: #e8ecf1;
    border: 1px solid #434d64;
    border-radius: 5px;
}
QListWidget::item { padding: 4px 8px; }
QListWidget::item:hover { background: #353e56; }
QListWidget::item:selected { background: #1d4ed8; color: #ffffff; }
