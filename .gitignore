# This file is used to ignore files which are generated
# ----------------------------------------------------------------------------

*~
*.autosave
*.a
*.core
*.moc
*.o
*.obj
*.orig
*.rej
*.so
*.so.*
*_pch.h.cpp
*_resource.rc
*.qm
.#*
*.*#
core
!core/
tags
.DS_Store
.directory
*.debug
Makefile*
*.prl
*.app
moc_*.cpp
ui_*.h
qrc_*.cpp
Thumbs.db
*.res
*.rc
/.qmake.cache
/.qmake.stash

# qtcreator generated files
*.pro.user*
*.qbs.user*
CMakeLists.txt.user*

# xemacs temporary files
*.flc

# Vim temporary files
.*.swp

# Visual Studio generated files
*.ib_pdb_index
*.idb
*.ilk
*.pdb
*.sln
*.suo
*.vcproj
*vcproj.*.*.user
*.ncb
*.sdf
*.opensdf
*.vcxproj
*vcxproj.*

# MinGW generated files
*.Debug
*.Release

# Python byte code
*.pyc

# Binaries
# --------
*.dll
*.exe

# Directories with generated files
.moc/
.obj/
.pch/
.rcc/
.uic/
/build*/
# 早期 qmake 曾在源码树里散落构建产物（release/、debug/）：里面是 moc_predefs.h、
# 生成的 qrc 等中间文件，跟踪它们会污染源码扫描（例如图标引用检查会读到旧引用）。
/release*/
/debug*/

# Local IDE state and runtime output
/.qtcreator/
/.vs/
/logs/
/captures/
/config-local/
/tests/stress/qa/
__pycache__/

# Local AI assistant workspace data
/.workbuddy/
/.gstack/
/.grok/
/.qm/
/.omc/

# Design drafts and working notes stay on this machine.
/design/
