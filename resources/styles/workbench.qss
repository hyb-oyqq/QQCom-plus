QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    /* Typography scale: body 13px, secondary 12px, section 15px, page 18px. */
    font-size: 13px;
    color: #182334;
}
QMainWindow, QWidget#centralwidget { background: #e9edf4; }
QLabel#Muted { color: #5c6880; font-size: 12px; }
QLabel#ByteCount { color: #1d4ed8; font-weight: 600; }
QLabel#EmptyState { background: #fbfcfe; color: #5c6880; border: 1px dashed #c3ccda; border-radius: 5px; }
QWidget#Surface { background: #ffffff; border: 1px solid #c8d1e0; border-radius: 8px; }
QFrame#EndpointBar { background: #ffffff; border-bottom: 1px solid #b9c4d6; }
QFrame#EndpointDivider { color: #d9e0ea; max-height: 1px; }
QFrame#BridgeDivider { color: #c8d1e0; max-width: 1px; }
QLabel#EndpointBadge { background: #1d4ed8; color: #ffffff; border: 1px solid #1a45c0; border-radius: 12px; font-weight: 700; }
PortSelectorWidget { background: #ffffff; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: #ffffff; }
QPushButton, QToolButton { background: #f4f6fa; border: 1px solid #a9b5c9; border-radius: 5px; padding: 4px 11px; min-height: 18px; color: #1f2a3d; }
QPushButton:hover, QToolButton:hover { color: #14326f; border-color: #6d87b8; background: #e8eefb; }
QPushButton:pressed, QToolButton:pressed { background: #d7e2f7; border-color: #4d6ba3; }
QPushButton:checked { background: #fde8c0; border-color: #c79a46; color: #70511c; }
QPushButton:disabled { background: #eceff5; border-color: #c3ccda; color: #7a8599; }
/* A/B 端点开关：选中=实心蓝（该端点数据显示中），未选中=灰（已停用），对比强、状态一眼可辨。 */
QPushButton#showPortA, QPushButton#showPortB { font-weight: 700; min-width: 26px; }
QPushButton#showPortA:checked, QPushButton#showPortB:checked { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; }
QPushButton#showPortA:checked:hover { background: #163fb3; border-color: #163fb3; }
QPushButton#showPortA:checked:pressed { background: #12369c; }
QPushButton#showPortA:!checked, QPushButton#showPortB:!checked { background: #e3e7ee; border-color: #c3ccda; color: #8a94a6; }
QPushButton#showPortA:!checked:hover { border-color: #9aa7bd; color: #6b7690; }
QPushButton#PrimaryButton { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-weight: 600; }
QPushButton#PrimaryButton:hover { background: #163fb3; border-color: #163fb3; }
QPushButton#PrimaryButton:disabled { background: #b7c5e6; border-color: #a8b8dd; color: #f0f3fa; }
QPushButton#bridgeButton { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-weight: 600; }
QPushButton#bridgeButton:hover { background: #163fb3; border-color: #163fb3; }
QPushButton#endpointAction { background: #1d4ed8; border-color: #1a45c0; color: #ffffff; font-weight: 600; }
QPushButton#endpointAction:hover { background: #163fb3; border-color: #163fb3; }
QPushButton#endpointAction:disabled { background: #b7c5e6; border-color: #a8b8dd; color: #f0f3fa; }
QPushButton#endpointAction[open="true"] { background: #c0392b; border-color: #a7301f; }
QPushButton#endpointAction[open="true"]:hover { background: #a7301f; border-color: #a7301f; }
QPushButton#bridgeButton:disabled { background: #b7c5e6; border-color: #a8b8dd; color: #f0f3fa; }
QToolButton::menu-indicator { width: 0px; }
QToolButton#advancedToggle { border: none; background: transparent; color: #647590; padding: 4px 2px; }
QToolButton#advancedToggle:hover { color: #3465d5; background: transparent; }
QToolButton#advancedToggle:checked { color: #3465d5; background: transparent; }
QWidget#advancedPanel { background: #f1f4fa; border-top: 1px solid #dde3ed; }
QLineEdit, QComboBox, QSpinBox { background: #ffffff; border: 1px solid #a9b5c9; border-radius: 5px; padding: 4px 7px; min-height: 18px; selection-background-color: #1d4ed8; selection-color: #ffffff; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #76869f; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus { border-color: #1d4ed8; }
QLineEdit[invalid="true"], QComboBox[invalid="true"], QSpinBox[invalid="true"] { border-color: #c0392b; background: #fdf4f3; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { background: #eceff5; color: #7a8599; border-color: #c3ccda; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 22px; border: none; }
QComboBox::down-arrow { image: url(:/icons/chevron-down.xpm); width: 10px; height: 6px; }
QComboBox QAbstractItemView { background: white; selection-background-color: #1d4ed8; selection-color: #ffffff; border: 1px solid #a9b5c9; outline: none; }
QPlainTextEdit { background: #ffffff; border: 1px solid #a9b5c9; border-radius: 5px; padding: 9px; selection-background-color: #1d4ed8; selection-color: #ffffff; }
QCheckBox { spacing: 6px; color: #1f2a3d; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #8b99b0; border-radius: 3px; background: #ffffff; }
QCheckBox::indicator:hover { border-color: #1d4ed8; }
QCheckBox::indicator:checked { background: #1d4ed8; border-color: #1a45c0; }
QWidget#BridgeRow { background: #eef2f9; }
QSplitter::handle { background: transparent; }
QSplitter::handle:vertical { height: 10px; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:hover { background: #d8e3f7; }
QStatusBar { background: #ffffff; border-top: 1px solid #b9c4d6; min-height: 30px; }
QStatusBar::item { border: none; }
QLabel#RxStatus { color: #047857; font-family: "Segoe UI"; font-weight: 600; }
QLabel#TxStatus { color: #1d4ed8; font-family: "Segoe UI"; font-weight: 600; }
QLabel#TrafficStatus { color: #5c6880; }
QMenu { background: white; border: 1px solid #a9b5c9; padding: 4px; }
QMenu::item { padding: 8px 20px; }
QMenu::item:selected { background: #d3e0fa; color: #14326f; }
QToolTip { color: #f4f6fa; background: #26324a; border: 1px solid #26324a; padding: 5px; }
QScrollBar:vertical { background: #e4eaf4; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #94a2b8; min-height: 30px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #76869f; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #e4eaf4; height: 9px; margin: 0; }
QScrollBar::handle:horizontal { background: #94a2b8; min-width: 30px; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* 过滤条（监视区第二行）：竖线用与端点分隔线同一族的浅灰；chip 用主色浅底，
   和工具条按钮区分开——它是"条件标签"，不是动作。 */
QFrame#FilterDivider { color: #d9e0ea; max-width: 1px; }
/* 常驻顶栏的方向 / 事件开关 与 条件条上的匹配选项、重新过滤：
   图标 + 文案，左右内边距比通用按钮收紧 3px，一行里唯一"可以再挤一点"的元素。 */
QPushButton#filterRx, QPushButton#filterTx, QPushButton#filterState,
QPushButton#filterWarning, QPushButton#filterError,
QPushButton#filterCaseSensitive, QPushButton#filterRegex,
QPushButton#filterRebuild { padding: 4px 8px; }

/* 指令面板样式 */
CommandPanel { background: #ffffff; border-left: 1px solid #c8d1e0; }
CommandPanel QTableWidget {
    background: #ffffff;
    border: 1px solid #c8d1e0;
    border-radius: 5px;
    gridline-color: #e4eaf4;
}
CommandPanel QTableWidget::item {
    padding: 4px;
    color: #182334;
}
CommandPanel QTableWidget::item:selected {
    background: #d3e0fa;
    color: #14326f;
}
CommandPanel QHeaderView::section {
    background: #f4f6fa;
    border: none;
    border-right: 1px solid #e4eaf4;
    border-bottom: 1px solid #c8d1e0;
    padding: 6px 4px;
    font-weight: 600;
    color: #5c6880;
}
CommandPanel QPushButton#primaryButton {
    background: #1d4ed8;
    border-color: #1a45c0;
    color: #ffffff;
    font-weight: 600;
}
CommandPanel QPushButton#primaryButton:hover {
    background: #163fb3;
    border-color: #163fb3;
}
CommandPanel QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #c8d1e0;
    border-radius: 5px;
    top: -1px;
}
CommandPanel QTabBar::tab {
    background: #f4f6fa;
    border: 1px solid #c8d1e0;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 6px 12px;
    margin-right: 2px;
    color: #5c6880;
}
CommandPanel QTabBar::tab:selected {
    background: #ffffff;
    color: #1d4ed8;
    font-weight: 600;
    border-bottom: 2px solid #1d4ed8;
}
CommandPanel QTabBar::tab:hover:!selected {
    background: #e8eefb;
    color: #14326f;
}
