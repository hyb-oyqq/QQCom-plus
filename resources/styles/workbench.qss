QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    font-size: 12px;
    color: #25324a;
}
QMainWindow, QWidget#centralwidget { background: #f3f5f9; }
QFrame#AppHeader { background: #ffffff; border-bottom: 1px solid #e0e5ed; }
QLabel#Logo { background: #3567df; color: white; border-radius: 10px; font-size: 23px; font-weight: 700; }
QLabel#Brand { font-family: "Segoe UI"; font-size: 23px; font-weight: 700; color: #1d2b44; }
QLabel#PreviewBadge { color: #8a6631; background: #fff4dd; border: 1px solid #f3e2be; border-radius: 4px; padding: 3px 8px; font-size: 11px; }
QLabel#SectionTitle { color: #25324a; font-size: 14px; font-weight: 600; }
QLabel#WorkspaceTitle { color: #25324a; font-size: 18px; font-weight: 600; }
QLabel#Muted { color: #8792a5; font-size: 11px; }
QLabel#CountBadge { color: #70809b; background: #eaf0f8; border-radius: 4px; padding: 1px 6px; font-size: 11px; }
QLabel#ByteCount { color: #376bd8; font-weight: 600; }
QLabel#InfoBox { background: #f3f6fb; color: #8490a1; padding: 10px; border-radius: 5px; line-height: 1.5; }
QLabel#EmptyState { background: #fcfdff; color: #8b97a9; border: 1px dashed #dce3ef; border-radius: 5px; }
QFrame#Sidebar { background: #ffffff; border-right: 1px solid #e0e5ed; }
QWidget#Surface { background: #ffffff; border: 1px solid #e0e6f0; border-radius: 8px; }
QFrame#Separator { color: #e6eaf1; max-height: 1px; margin: 4px 16px; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: #ffffff; }
QPushButton, QToolButton { background: #ffffff; border: 1px solid #dce3ed; border-radius: 5px; padding: 5px 12px; min-height: 20px; }
QPushButton:hover, QToolButton:hover { color: #3465d5; border-color: #9db7ec; background: #f6f9ff; }
QPushButton:pressed, QToolButton:pressed { background: #eaf1ff; }
QPushButton:checked { background: #fff1d9; border-color: #ead4a9; color: #946b28; }
QPushButton:disabled { background: #f3f5f9; border-color: #e5e9f0; color: #a8b2c2; }
QPushButton#PrimaryButton { background: #386add; border-color: #386add; color: #ffffff; font-weight: 600; }
QPushButton#PrimaryButton:hover { background: #295acf; }
QPushButton#PrimaryButton:disabled { background: #e5ecfb; border-color: #e5ecfb; color: #94aadd; }
QToolButton::menu-indicator { width: 0px; }
QToolButton#addPort { border: none; background: transparent; color: #376bd8; padding: 4px; }
QToolButton#advancedSerial { border: none; background: transparent; color: #647590; text-align: left; padding-left: 0px; }
QLineEdit, QComboBox, QSpinBox { background: #ffffff; border: 1px solid #dce3ed; border-radius: 5px; padding: 5px 7px; min-height: 20px; selection-background-color: #dce8ff; selection-color: #25324a; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus { border-color: #7099ed; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { background: #f5f7fa; color: #9ba6b8; }
QComboBox { padding-right: 24px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 22px; border: none; }
QComboBox QAbstractItemView { background: white; selection-background-color: #edf3ff; selection-color: #315da9; border: 1px solid #dce3ed; outline: none; }
QPlainTextEdit { background: #fafcff; border: 1px solid #dce3ed; border-radius: 5px; padding: 9px; selection-background-color: #dce8ff; }
QCheckBox { spacing: 6px; }
QCheckBox::indicator { width: 13px; height: 13px; }
QListWidget#portList { background: #ffffff; border: none; padding: 0px 10px 8px 10px; outline: none; }
QListWidget#portList::item { background: #ffffff; border: 1px solid transparent; border-radius: 6px; padding: 0px 11px; color: #62718b; }
QListWidget#portList::item:hover { background: #f6f8fc; }
QListWidget#portList::item:selected { background: #edf3ff; border-color: #dce7fb; color: #285fca; }
QTableView { background: white; alternate-background-color: #fafbfd; border: 1px solid #e5eaf2; border-radius: 4px; selection-background-color: #edf3ff; selection-color: #294e87; outline: none; }
QTableView::item { padding: 4px 8px; border: none; }
QTableView::item:selected { background: #edf3ff; color: #294e87; }
QHeaderView::section { background: #f6f8fc; color: #7f8ba0; border: none; border-bottom: 1px solid #e6ebf3; padding: 8px; font-weight: 400; text-align: left; }
QTabWidget::pane { border: none; background: white; }
QTabBar::tab { background: transparent; padding: 12px 22px 10px 22px; color: #8090a9; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #3567d7; border-bottom: 2px solid #3567d7; font-weight: 600; }
QTabBar::tab:hover { color: #3567d7; background: #f8faff; }
QSplitter::handle { background: transparent; }
QSplitter::handle:vertical { height: 10px; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:hover { background: #d8e3f7; }
QStatusBar { background: #ffffff; border-top: 1px solid #e0e5ed; min-height: 32px; }
QStatusBar::item { border: none; }
QLabel#RxStatus { color: #128378; font-family: "Segoe UI"; font-weight: 600; }
QLabel#TxStatus { color: #4672ce; font-family: "Segoe UI"; font-weight: 600; }
QMenu { background: white; border: 1px solid #dce3ed; padding: 4px; }
QMenu::item { padding: 8px 20px; }
QMenu::item:selected { background: #edf3ff; color: #3567d7; }
QToolTip { color: #354663; background: #ffffff; border: 1px solid #dce3ed; padding: 5px; }
QScrollBar:vertical { background: #f5f7fb; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #ced7e5; min-height: 30px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #f5f7fb; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: #ced7e5; min-width: 30px; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
